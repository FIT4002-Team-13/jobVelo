# Copy to backend/.env and fill in the blanks. Never commit .env.
# Values shown for non-secret settings are the defaults from config.py.

# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=jobvelo
CORS_ORIGINS=http://localhost:5173

# --- Auth -------------------------------------------------------------------
# Set to "production" on the deployed server: the backend then refuses to start
# without JWT_SECRET (in development it falls back to a random per-process key).
APP_ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required for any non-local deployment. Dev falls back to a per-process random key.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Deepgram: realtime speech-to-text (interview transcription) ------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# Silence (ms) that ends a sentence. Higher = fuller sentences, slower lines.
DEEPGRAM_ENDPOINTING_MS=400

# --- OpenAI: plan, questions, bias check, reports, ratings ------------------
OPENAI_API_KEY=
OPENAI_QUESTION_MODEL=gpt-4o-mini
OPENAI_BIAS_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o

# --- Gemini: CV analysis, interviewer feedback, behavioural suggestions -----
GEMINI_API_KEY=
GEMINI_CV_MODEL=gemini-flash-latest

# --- Files ------------------------------------------------------------------
# Relative paths resolve against the backend working directory.
UPLOADS_DIR=uploads
