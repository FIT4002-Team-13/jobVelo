MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=jobvelo
CORS_ORIGINS=http://localhost:5173

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required for any non-local deployment. Dev falls back to a per-process random key.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Realtime speech-to-text (interview transcription)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# OpenAI — realtime question generation, summary, scoring
OPENAI_API_KEY=
OPENAI_QUESTION_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o

# Gemini — CV analysis (multimodal: PDF/image input)
GEMINI_API_KEY=
GEMINI_CV_MODEL=gemini-2.0-flash
