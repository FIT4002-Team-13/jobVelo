# --- Database ---------------------------------------------------------------
# The backend always connects with TLS, so use an Atlas URI (or a TLS-enabled
# local server) - a plain local mongod will not connect.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=jobvelo

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Auth -------------------------------------------------------------------
# Leave blank locally and a random key is generated per server start (you'll
# just be logged out on restart). Set a long random value for any deployment.
JWT_SECRET=

# --- AI services ------------------------------------------------------------
# Deepgram - live interview transcription
DEEPGRAM_API_KEY=
# OpenAI - live question suggestions, bias checks, reports and scoring
OPENAI_API_KEY=
# Gemini - CV / cover-letter analysis
GEMINI_API_KEY=

# --- Optional model overrides (defaults shown) ------------------------------
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080
# DEEPGRAM_MODEL=nova-2
# DEEPGRAM_ENDPOINTING_MS=400
# OPENAI_QUESTION_MODEL=gpt-4.1-mini
# OPENAI_ANALYSIS_MODEL=gpt-4.1
# OPENAI_BIAS_MODEL=gpt-4o-mini
# GEMINI_CV_MODEL=gemini-pro-latest
